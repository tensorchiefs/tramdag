# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
*.egg-info/

# Experiment outputs are regenerable and never committed. The frozen input
# data under experiments/data/ IS tracked.
results/

# R
.Rhistory
.RData

# Notebooks: jupytext py:percent files are the source of truth;
# generated .ipynb (with embedded image outputs) stay out of git.
notebooks/*.ipynb
# exception: the Colab demo needs a tracked (output-stripped) ipynb for the
# "Open in Colab" badge; regenerate with `uvx jupytext --to ipynb <demo>.py`
!notebooks/demo_tram_dag_colab.ipynb

# build artifacts
dist/

# machine-benchmark outputs (collected manually per machine)
perf_*.json

# jupyter runtime litter
.ipynb_checkpoints/
.virtual_documents/

# docs build scratch (stub modules, notebook markdown)
build/

# Emacs texfrag LaTeX-preview scratch, and pandoc exports of the guides
texfrag/
docs/*.html

# working ledger of the 2026-08 review — local only
REVIEW.md

# emacs lock files
.#*

# personal scratch — notes in progress, never committed
scratch/
.DS_Store
site/
.cache/
architecture-overview.html
